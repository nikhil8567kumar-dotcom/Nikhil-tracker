<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>NikRises — System</title>
<style>
:root{--bg:#0a0a0f;--s:#111118;--c:#16161e;--b:#252530;--g:#39ff14;--gd:rgba(57,255,20,0.1);--gg:rgba(57,255,20,0.35);--w:#efefef;--m:#555;--r:#ff3c3c;--y:#ffd600;}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{background:var(--bg);color:var(--w);font-family:system-ui,sans-serif;min-height:100vh;padding:18px 14px 100px;max-width:480px;margin:0 auto;}
.mono{font-family:monospace;}
.big{font-size:38px;font-weight:900;letter-spacing:2px;line-height:1;}
.green{color:var(--g);}
.red{color:var(--r);}
.yellow{color:var(--y);}
.muted{color:var(--m);font-family:monospace;font-size:10px;letter-spacing:1px;}
.card{background:var(--c);border:1px solid var(--b);border-radius:14px;padding:14px 16px;margin-bottom:10px;}
.surface{background:var(--s);border:1px solid var(--b);border-radius:14px;padding:14px 16px;margin-bottom:10px;}
.seclbl{font-family:monospace;font-size:9px;letter-spacing:2.5px;color:var(--m);text-transform:uppercase;margin:14px 0 8px 2px;}
/* TABS */
.tabs{display:flex;gap:6px;margin-bottom:16px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none;}
.tabs::-webkit-scrollbar{display:none;}
.tab{flex-shrink:0;padding:8px 13px;background:var(--s);border:1px solid var(--b);border-radius:8px;color:var(--m);font-family:monospace;font-size:9px;letter-spacing:1.5px;text-transform:uppercase;cursor:pointer;white-space:nowrap;}
.tab.active{background:var(--gd);border-color:rgba(57,255,20,0.3);color:var(--g);}
.panel{display:none;}.panel.active{display:block;}
/* BAR */
.bar-bg{height:6px;background:var(--b);border-radius:99px;overflow:hidden;}
.bar-fill{height:100%;border-radius:99px;transition:width 0.5s;}
/* HABIT ROW */
.hrow{display:flex;align-items:center;gap:12px;background:var(--c);border:1px solid var(--b);border-radius:12px;padding:13px 14px;margin-bottom:8px;cursor:pointer;user-select:none;transition:all 0.15s;}
.hrow.done{background:rgba(57,255,20,0.04);border-color:rgba(57,255,20,0.2);}
.chk{width:22px;height:22px;border-radius:6px;border:2px solid var(--b);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;transition:all 0.15s;}
.hrow.done .chk{background:var(--g);border-color:var(--g);color:#000;box-shadow:0 0 10px var(--gg);}
.htxt{flex:1;font-size:14px;font-weight:600;transition:all 0.15s;}
.hrow.done .htxt{color:rgba(240,240,240,0.3);text-decoration:line-through;text-decoration-color:var(--g);}
.badge{font-family:monospace;font-size:9px;color:var(--g);background:var(--gd);border:1px solid rgba(57,255,20,0.2);border-radius:6px;padding:2px 6px;flex-shrink:0;}
/* RANK HERO */
.rank-hero{background:var(--s);border-radius:16px;padding:16px;margin-bottom:12px;position:relative;overflow:hidden;}
.rank-glow{position:absolute;inset:0;pointer-events:none;}
/* POPUP */
.popup{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:var(--c);border-radius:20px;padding:20px 28px;text-align:center;z-index:200;display:none;min-width:180px;}
.popup.show{display:block;}
.popup .pnum{font-size:52px;font-weight:900;line-height:1;}
.popup .plbl{font-family:monospace;font-size:10px;color:var(--m);letter-spacing:2px;margin-top:4px;}
/* LEVELUP */
.levelup{position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:300;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;}
.levelup.show{display:flex;}
.lu-rank{font-size:100px;font-weight:900;line-height:1;}
/* CONFIRM */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:100;display:none;align-items:center;justify-content:center;}
.overlay.show{display:flex;}
.obox{background:var(--c);border:1px solid var(--b);border-radius:18px;padding:24px 20px;width:88%;max-width:340px;text-align:center;}
/* BUTTONS */
.btn{padding:12px 16px;border-radius:10px;font-size:13px;font-weight:800;cursor:pointer;width:100%;font-family:system-ui,sans-serif;border:none;margin-top:8px;}
.btn-g{background:rgba(57,255,20,0.12);border:1px solid rgba(57,255,20,0.3)!important;color:var(--g);}
.btn-r{background:rgba(255,60,60,0.08);border:1px solid rgba(255,60,60,0.2)!important;color:var(--r);}
.btn-y{background:rgba(255,214,0,0.1);border:1px solid rgba(255,214,0,0.3)!important;color:var(--y);}
.btn-save{background:rgba(229,57,53,0.15);border:1px solid rgba(229,57,53,0.3)!important;color:var(--w);}
/* TODO */
.todo-row{display:flex;align-items:center;gap:12px;background:var(--c);border:1px solid var(--b);border-radius:12px;padding:13px 14px;margin-bottom:8px;}
.todo-row.done-t{background:rgba(57,255,20,0.04);border-color:rgba(57,255,20,0.2);}
.del-btn{background:none;border:none;color:var(--m);font-size:16px;cursor:pointer;padding:2px 4px;}
/* INPUT */
.inp{flex:1;background:var(--c);border:1px solid var(--b);border-radius:10px;padding:12px 14px;color:var(--w);font-family:system-ui,sans-serif;font-size:13px;outline:none;}
.inp:focus{border-color:rgba(57,255,20,0.3);}
.add-btn{background:var(--g);border:none;border-radius:10px;width:44px;height:44px;font-size:22px;font-weight:700;color:#000;cursor:pointer;flex-shrink:0;}
/* PUNISHMENT */
.punish{background:rgba(255,60,60,0.08);border:1px solid rgba(255,60,60,0.25);border-radius:12px;padding:12px 14px;margin-bottom:12px;display:none;}
.punish.show{display:block;}
/* RANK PAGE */
.rank-row{border-radius:12px;padding:14px 16px;margin-bottom:8px;border:1px solid var(--b);}
.rank-row.current-rank{border-width:1.5px;}
/* PILL */
.pill{font-size:10px;font-weight:600;padding:3px 8px;border-radius:99px;font-family:monospace;margin-right:4px;margin-bottom:4px;display:inline-block;}
.pill.ok{background:rgba(57,255,20,0.1);color:var(--g);border:1px solid rgba(57,255,20,0.2);}
.pill.no{background:rgba(255,60,60,0.07);color:var(--r);border:1px solid rgba(255,60,60,0.18);}
/* PMO BTN */
.pmo-btn{display:flex;flex-direction:column;align-items:center;background:var(--s);border:1.5px solid var(--b);border-radius:14px;padding:8px 12px;cursor:pointer;min-width:64px;}
.pmo-btn:active{transform:scale(0.94);}
/* NOTE */
.note-ta{width:100%;background:var(--c);border:1px solid var(--b);border-radius:12px;padding:14px 16px;color:var(--w);font-family:system-ui,sans-serif;font-size:13px;resize:none;min-height:70px;outline:none;line-height:1.5;}
.note-ta:focus{border-color:rgba(57,255,20,0.3);}
/* STRUGGLE BAR */
.sbar-bg{flex:1;height:5px;background:var(--b);border-radius:99px;overflow:hidden;}
.sbar-fill{height:100%;border-radius:99px;}
</style>
</head>
<body>

<!-- EXP POPUP -->
<div class="popup" id="popup">
  <div class="pnum" id="popNum">+100</div>
  <div class="plbl" id="popLbl">EXP GAINED</div>
</div>

<!-- LEVEL UP -->
<div class="levelup" id="levelup">
  <div class="lu-rank" id="luRank">C</div>
  <div style="font-size:28px;font-weight:900;color:var(--w);letter-spacing:3px;margin-top:8px;">RANK UP!</div>
  <div id="luName" style="font-family:monospace;font-size:14px;letter-spacing:2px;margin-top:6px;"></div>
  <button onclick="closeLevelUp()" id="luBtn" style="margin-top:24px;border:none;border-radius:12px;padding:14px 32px;font-size:18px;letter-spacing:2px;color:#000;cursor:pointer;font-weight:900;">ARISE ⚔️</button>
</div>

<!-- PMO CONFIRM -->
<div class="overlay" id="pmoOverlay">
  <div class="obox">
    <div style="font-size:22px;color:var(--r);font-weight:900;margin-bottom:8px;">Reset Streak?</div>
    <p id="pmoConfirmText" style="font-size:13px;color:var(--m);margin-bottom:20px;line-height:1.5;"></p>
    <div style="display:flex;gap:10px;">
      <button onclick="closePmoConfirm()" style="flex:1;padding:12px;border-radius:10px;border:1px solid var(--b);background:var(--s);color:var(--w);cursor:pointer;font-size:14px;font-weight:700;">Cancel</button>
      <button onclick="confirmRelapse()" style="flex:1;padding:12px;border-radius:10px;border:none;background:var(--r);color:#fff;cursor:pointer;font-size:14px;font-weight:700;">Reset</button>
    </div>
  </div>
</div>

<!-- HEADER -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
  <div>
    <div class="big">NIK<span class="green">RISES</span></div>
    <div class="muted" style="margin-top:2px;">⚡ Solo Leveling System</div>
  </div>
  <div class="pmo-btn" onclick="addPmoDay()">
    <div id="pmoDays" style="font-size:26px;color:var(--g);font-weight:900;line-height:1;">0</div>
    <div style="font-family:monospace;font-size:7px;color:var(--m);letter-spacing:1px;text-transform:uppercase;margin-top:2px;">PMO Free</div>
    <div style="font-size:9px;color:var(--g);font-family:monospace;margin-top:3px;opacity:0.7;">+ Day</div>
  </div>
</div>

<!-- RANK HERO -->
<div class="rank-hero" id="rankHero">
  <div class="rank-glow" id="rankGlow"></div>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
    <div id="rankBadge" style="font-size:56px;font-weight:900;line-height:1;">E</div>
    <div style="text-align:right;">
      <div id="rankName" style="font-size:18px;font-weight:700;color:var(--w);">Iron Hunter</div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:2px;">
        <div class="muted">HUNTER RANK</div>
        <div id="levelDisp" style="font-family:monospace;font-size:10px;color:var(--g);background:var(--gd);border:1px solid rgba(57,255,20,0.2);border-radius:6px;padding:2px 7px;">LVL 1</div>
      </div>
    </div>
  </div>
  <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
    <span class="muted">EXP Progress</span>
    <span id="expFraction" style="font-family:monospace;font-size:11px;color:var(--w);font-weight:700;">0 / 2000</span>
  </div>
  <div class="bar-bg"><div id="expBar" class="bar-fill" style="width:0%;background:var(--g);box-shadow:0 0 8px var(--gg);"></div></div>
  <div style="display:flex;justify-content:space-between;margin-top:12px;">
    <div style="text-align:center;"><div id="totalExpDisp" style="font-size:18px;font-weight:900;color:var(--g);">0</div><div style="font-family:monospace;font-size:8px;color:var(--m);text-transform:uppercase;">Total EXP</div></div>
    <div style="text-align:center;"><div id="toNextDisp" style="font-size:18px;font-weight:900;color:var(--w);">2000</div><div style="font-family:monospace;font-size:8px;color:var(--m);text-transform:uppercase;">To Next</div></div>
    <div style="text-align:center;"><div id="penaltiesDisp" style="font-size:18px;font-weight:900;color:var(--r);">0</div><div style="font-family:monospace;font-size:8px;color:var(--m);text-transform:uppercase;">Penalties</div></div>
  </div>
</div>

<!-- DATE BAR -->
<div style="background:var(--s);border:1px solid var(--b);border-radius:10px;padding:10px 14px;display:flex;justify-content:space-between;margin-bottom:12px;">
  <span id="dateDisp" style="font-family:monospace;font-size:11px;color:var(--g);letter-spacing:1px;"></span>
  <span id="timerDisp" class="muted">00:00:00</span>
</div>

<!-- PROGRESS -->
<div style="margin-bottom:14px;">
  <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
    <span style="font-size:10px;font-weight:700;color:var(--m);letter-spacing:2px;text-transform:uppercase;">Today's Progress</span>
    <span id="progressTxt" style="font-size:20px;font-weight:900;color:var(--g);">0/7</span>
  </div>
  <div class="bar-bg"><div id="progressBar" class="bar-fill" style="width:0%;background:var(--g);box-shadow:0 0 8px var(--gg);"></div></div>
</div>

<!-- PUNISHMENT -->
<div class="punish" id="punishBanner">
  <div style="font-size:15px;color:var(--r);font-weight:900;">⚠ PENALTY QUEST ACTIVE</div>
  <div id="punishMeta" style="font-family:monospace;font-size:10px;color:var(--r);margin-top:4px;"></div>
  <div id="punishTask" style="font-size:13px;font-weight:700;color:var(--r);margin:8px 0;"></div>
  <button class="btn btn-g" onclick="completePunishment()">✓ Punishment Complete — Claim +300 EXP</button>
</div>

<!-- TABS -->
<div class="tabs">
  <button class="tab active" onclick="switchTab('today',this)">Today</button>
  <button class="tab" onclick="switchTab('quests',this)">Quests</button>
  <button class="tab" onclick="switchTab('ranks',this)">Ranks</button>
  <button class="tab" onclick="switchTab('struggles',this)">Struggles</button>
  <button class="tab" onclick="switchTab('history',this)">History</button>
  <button class="tab" onclick="switchTab('pmo',this)">PMO</button>
</div>

<!-- TODAY -->
<div class="panel active" id="panel-today">
  <div id="habitsList"></div>
  <div class="seclbl">Quick Note</div>
  <textarea class="note-ta" id="noteBox" placeholder="Anything on your mind today..." oninput="saveNote()"></textarea>
  <button class="btn btn-save" style="margin-top:10px;" onclick="saveDay()">✓ Save Day to History</button>
</div>

<!-- QUESTS -->
<div class="panel" id="panel-quests">
  <div id="dailyQuestBox"></div>
  <div class="seclbl">Your Quests (+50 EXP each)</div>
  <div style="display:flex;gap:8px;margin-bottom:12px;">
    <input class="inp" id="todoInput" placeholder="Add a quest for today..." maxlength="80" onkeydown="if(event.key==='Enter')addTodo()">
    <button class="add-btn" onclick="addTodo()">+</button>
  </div>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
    <span class="muted" id="todoCount">0 quests</span>
    <button onclick="clearDone()" style="font-family:monospace;font-size:9px;color:var(--m);background:none;border:1px solid var(--b);border-radius:6px;padding:4px 10px;cursor:pointer;">Clear done</button>
  </div>
  <div id="todoList"></div>
</div>

<!-- RANKS -->
<div class="panel" id="panel-ranks">
  <div class="seclbl">All Ranks</div>
  <div id="ranksList"></div>
  <div class="surface" style="margin-top:6px;">
    <div class="seclbl" style="margin-top:0;">EXP Guide</div>
    <div id="expGuide"></div>
  </div>
</div>

<!-- STRUGGLES -->
<div class="panel" id="panel-struggles">
  <div class="seclbl">Habit Completion Rate</div>
  <div class="muted" style="margin-bottom:14px;">Based on saved history • Worst habits first</div>
  <div id="struggleList"></div>
  <div id="overallStats"></div>
</div>

<!-- HISTORY -->
<div class="panel" id="panel-history">
  <div class="seclbl">Past Days</div>
  <div id="historyList"></div>
</div>

<!-- PMO -->
<div class="panel" id="panel-pmo">
  <div class="surface" style="text-align:center;">
    <div id="pmoDisplay" style="font-size:64px;font-weight:900;color:var(--g);text-shadow:0 0 20px var(--gg);line-height:1;">0</div>
    <div class="muted" style="margin-top:4px;letter-spacing:1.5px;text-transform:uppercase;">Days PMO Free</div>
    <div style="display:flex;justify-content:center;gap:30px;margin-top:14px;">
      <div style="text-align:center;"><div id="pmoBest" style="font-size:22px;font-weight:900;">0</div><div class="muted" style="text-transform:uppercase;">Best Streak</div></div>
      <div style="text-align:center;"><div id="pmoResets" style="font-size:22px;font-weight:900;">0</div><div class="muted" style="text-transform:uppercase;">Total Resets</div></div>
    </div>
    <button class="btn btn-g" onclick="addPmoDay()" style="margin-top:14px;">+ Add Clean Day (+100 EXP)</button>
    <button class="btn btn-r" onclick="showPmoConfirm()">⚠ I relapsed — reset streak</button>
  </div>
  <div class="muted" style="text-align:center;line-height:1.8;margin-top:14px;padding:0 10px;">
    Every day you hold is a win.<br>
    Under 5 days → relapse = <span class="red">-500 EXP</span><br>
    5+ days → relapse = only <span class="yellow">-100 EXP</span>
  </div>
</div>

<script>
const HABITS=[
  {id:"affirmAM", text:"🌅 Morning affirmations + visualization"},
  {id:"meditation",text:"🧘 Morning meditation"},
  {id:"workout",  text:"🏋️ Workout + Boxing done"},
  {id:"reading",  text:"📖 Daily reading done"},
  {id:"talk",     text:"💬 Real human interaction"},
  {id:"income",   text:"💰 One income / content action"},
  {id:"affirmPM", text:"🌙 Night affirmations + visualization"},
];
const RANKS=[
  {rank:"E",  name:"Iron Hunter",      color:"#888",   bg:"rgba(136,136,136,0.08)",min:0,     max:2000  },
  {rank:"D",  name:"Bronze Hunter",    color:"#4fc3f7",bg:"rgba(79,195,247,0.08)", min:2000,  max:8000  },
  {rank:"C",  name:"Silver Hunter",    color:"#39ff14",bg:"rgba(57,255,20,0.08)",  min:8000,  max:25000 },
  {rank:"B",  name:"Gold Hunter",      color:"#ff9800",bg:"rgba(255,152,0,0.08)",  min:25000, max:60000 },
  {rank:"A",  name:"Shadow Monarch",   color:"#b388ff",bg:"rgba(179,136,255,0.08)",min:60000, max:120000},
  {rank:"S",  name:"S-Rank Hunter",    color:"#ffd600",bg:"rgba(255,214,0,0.08)",  min:120000,max:250000},
  {rank:"SS", name:"Absolute",         color:"#ff6ec7",bg:"rgba(255,110,199,0.08)",min:250000,max:500000},
  {rank:"SSS",name:"The Awakened One", color:"#ff3c3c",bg:"rgba(255,60,60,0.08)",  min:500000,max:999999},
];
const DAILY_QUESTS=[
  {task:"Film and upload 1 Instagram Reel today",exp:150},
  {task:"Write and upload 1 Pocket FM episode",exp:150},
  {task:"Write 3 Quora answers today",exp:120},
  {task:"Write 1 new chapter for your next ebook",exp:150},
  {task:"Research 5 trending topics for content",exp:80},
  {task:"Reply to every comment on your last reel",exp:70},
  {task:"Plan next 7 days of content in detail",exp:100},
  {task:"Write scripts for your next 3 reels",exp:120},
  {task:"Create or update a Gumroad product",exp:130},
  {task:"Spend 1 hour studying your analytics",exp:90},
  {task:"Find and apply to 1 new affiliate program",exp:100},
  {task:"Add 5 new pins to Pinterest today",exp:70},
  {task:"Do 100 extra pushups on top of workout",exp:80},
  {task:"Train boxing for 30 extra minutes",exp:80},
  {task:"Go for a 5KM walk or run outside",exp:90},
  {task:"10 minute cold shower today",exp:70},
  {task:"Sleep before 11PM tonight",exp:60},
  {task:"Eat clean all day — zero junk food",exp:70},
  {task:"Drink 3 litres of water today",exp:50},
  {task:"Do 200 squats throughout the day",exp:70},
  {task:"Meditate for 20 extra minutes",exp:60},
  {task:"Write in a journal for 15 minutes",exp:50},
  {task:"Practice English speaking for 30 minutes",exp:70},
  {task:"Watch 1 educational video and take notes",exp:60},
  {task:"Write your top 3 goals and why they matter",exp:50},
  {task:"Full digital detox for 2 hours",exp:80},
  {task:"Call or meet someone who inspires you",exp:70},
  {task:"Read 1 chapter of a business book",exp:70},
  {task:"Review your weekly progress deeply",exp:100},
];
const P1=["50 Pushups before midnight","30 min walk outside","1 hour deep work no phone","100 Jumping Jacks","Cold shower today"];
const P2=["100 Pushups before midnight","5KM walk or run today","2 hours deep work no distractions","200 Jumping Jacks + 100 Crunches","Read for 1 hour non-stop"];
const P3=["200 Pushups + 200 Squats before midnight","10KM walk no excuses","4 hours deep work phone away","100 Burpees + 100 Pushups","No social media all day"];
const P4=["300 Pushups + 300 Squats + 5KM run all today","15KM walk no shortcuts","6 hours deep work phone off","150 Burpees + 150 Pushups + 150 Squats","Full phone detox calls only"];
const EXP_GUIDE=[["Habit tick","#39ff14","+100"],["Perfect day","#39ff14","+200 bonus"],["System quest","#ffd600","up to +150"],["Custom quest","#39ff14","+50"],["PMO clean day","#39ff14","+100"],["Punishment cleared","#39ff14","+300"],["Habit untick","#ff3c3c","-100"],["Miss habits","#ff3c3c","-100 per missed"]];
const KEY='nikhil_sys_v1';
function load(){try{return JSON.parse(localStorage.getItem(KEY))||{}}catch{return{}}}
function save(d){localStorage.setItem(KEY,JSON.stringify(d))}
function todayKey(){const d=new Date();return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function getRank(exp){for(let i=RANKS.length-1;i>=0;i--)if(exp>=RANKS[i].min)return RANKS[i];return RANKS[0]}
function getDQ(){const seed=todayKey().split('-').reduce((a,b)=>a+parseInt(b),0);return DAILY_QUESTS[seed%DAILY_QUESTS.length]}
function rnd(a){return a[Math.floor(Math.random()*a.length)]}
function fmtDate(){const n=new Date(),days=["SUN","MON","TUE","WED","THU","FRI","SAT"],months=["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];return`${days[n.getDay()]} ${n.getDate()} ${months[n.getMonth()]} ${n.getFullYear()}`}
function num(n){return n.toLocaleString()}

// STATE
let store=load();
// Restore Nikhil's progress if localStorage is empty (fresh GitHub load)
if(!store.totalExp && !store.today){
  store={
    totalExp: 9300,
    penalties: 2,
    pmo: { days: 2, best: 3, resets: 4 },
    today: { date: todayKey(), checked: {}, todos: [], note: '', dailyQuestDone: false },
    history: [],
    punishment: null,
  };
  save(store);
}
const today=todayKey();
if(!store.today||store.today.date!==today){
  if(store.today&&store.today.date){
    if(!store.history)store.history=[];
    // If punishment was active and not completed = -1000 EXP
    if(store.punishment&&store.punishment.active&&store.punishment.date!==today){
      store.totalExp=Math.max(0,(store.totalExp||0)-1000);
      store.penalties=(store.penalties||0)+1;
    }
    const missed=HABITS.filter(h=>!store.today.checked[h.id]).length;
    if(missed>0){
      const penalty=missed*100;
      store.totalExp=Math.max(0,(store.totalExp||0)-penalty);
      store.penalties=(store.penalties||0)+1;
      let pool=missed===1?P1:missed<=3?P2:missed<=5?P3:P4;
      store.punishment={active:true,task:rnd(pool),date:today,missed,penalty};
    } else {
      store.totalExp=(store.totalExp||0)+200;
    }
    if(!store.history.find(h=>h.date===store.today.date))store.history.unshift({...store.today});
    if(store.history.length>60)store.history=store.history.slice(0,60);
  }
  store.today={date:today,checked:{},todos:[],note:'',dailyQuestDone:false};
  save(store);
}
if(!store.pmo)store.pmo={days:0,best:0,resets:0};
if(!store.totalExp)store.totalExp=0;
if(!store.penalties)store.penalties=0;
if(!store.history)store.history=[];

let popTimer=null;
function showPop(amt,lbl){
  const p=document.getElementById('popup');
  const n=document.getElementById('popNum');
  const l=document.getElementById('popLbl');
  n.textContent=(amt>0?'+':'')+amt;
  n.style.color=amt>0?'#39ff14':'#ff3c3c';
  l.textContent=lbl;
  p.style.border=`2px solid ${amt>0?'#39ff14':'#ff3c3c'}`;
  p.style.boxShadow=`0 0 40px ${amt>0?'rgba(57,255,20,0.3)':'rgba(255,60,60,0.3)'}`;
  p.classList.add('show');
  if(popTimer)clearTimeout(popTimer);
  popTimer=setTimeout(()=>p.classList.remove('show'),1800);
}

function applyExp(amt,lbl){
  const prevRank=getRank(store.totalExp).rank;
  store.totalExp=Math.max(0,(store.totalExp||0)+amt);
  const newRank=getRank(store.totalExp);
  showPop(amt,lbl);
  if(newRank.rank!==prevRank&&amt>0){
    setTimeout(()=>{
      const lu=document.getElementById('levelup');
      document.getElementById('luRank').textContent=newRank.rank;
      document.getElementById('luRank').style.color=newRank.color;
      document.getElementById('luRank').style.textShadow=`0 0 40px ${newRank.color}`;
      document.getElementById('luName').textContent=newRank.name;
      document.getElementById('luName').style.color=newRank.color;
      document.getElementById('luBtn').style.background=newRank.color;
      lu.classList.add('show');
    },400);
  }
  save(store);
  renderRankHero();
}
function closeLevelUp(){document.getElementById('levelup').classList.remove('show')}

// RENDER RANK HERO
function renderRankHero(){
  const r=getRank(store.totalExp);
  const next=RANKS[RANKS.indexOf(r)+1]||r;
  const inRank=store.totalExp-r.min;
  const needed=r.max-r.min;
  const pct=Math.min(100,(inRank/needed)*100);
  document.getElementById('rankBadge').textContent=r.rank;
  document.getElementById('rankBadge').style.color=r.color;
  document.getElementById('rankBadge').style.textShadow=`0 0 30px ${r.color}`;
  document.getElementById('rankName').textContent=r.name;
  document.getElementById('levelDisp').textContent='LVL '+Math.floor(store.totalExp/1000);
  document.getElementById('rankHero').style.borderColor=r.color+'40';
  document.getElementById('rankGlow').style.background=`radial-gradient(ellipse at top left,${r.bg} 0%,transparent 60%)`;
  document.getElementById('expBar').style.width=pct+'%';
  document.getElementById('expBar').style.background=r.color;
  document.getElementById('expBar').style.boxShadow=`0 0 8px ${r.color}80`;
  document.getElementById('expFraction').textContent=`${num(inRank)} / ${num(needed)}`;
  document.getElementById('totalExpDisp').textContent=num(store.totalExp);
  document.getElementById('totalExpDisp').style.color=r.color;
  document.getElementById('toNextDisp').textContent=num(r.max-store.totalExp);
  document.getElementById('penaltiesDisp').textContent=store.penalties||0;
}

// HABITS
function renderHabits(){
  const list=document.getElementById('habitsList');
  list.innerHTML='';
  let done=0;
  HABITS.forEach(h=>{
    const isDone=!!store.today.checked[h.id];
    if(isDone)done++;
    const row=document.createElement('div');
    row.className='hrow'+(isDone?' done':'');
    row.innerHTML=`<div class="chk">${isDone?'✓':''}</div><div class="htxt">${h.text}</div><div class="badge">+100</div>`;
    row.onclick=()=>toggleHabit(h.id);
    list.appendChild(row);
  });
  document.getElementById('progressTxt').textContent=`${done}/${HABITS.length}`;
  document.getElementById('progressBar').style.width=`${(done/HABITS.length)*100}%`;
}
function toggleHabit(id){
  const was=!!store.today.checked[id];
  store.today.checked[id]=!was;
  applyExp(was?-100:100, was?'Habit unticked -100 EXP':'Habit done! +100 EXP 💪');
  renderHabits();
  autoSave();
}

// NOTE
function saveNote(){store.today.note=document.getElementById('noteBox').value;save(store);}

// SAVE DAY
function saveDay(){
  autoSave();
  const btn=event.target;
  btn.textContent='✓ Saved!';
  setTimeout(()=>btn.textContent='✓ Save Day to History',2000);
}
function autoSave(){
  if(!store.history)store.history=[];
  const idx=store.history.findIndex(h=>h.date===store.today.date);
  if(idx>=0)store.history[idx]={...store.today};
  else store.history.unshift({...store.today});
  save(store);
}

// PUNISHMENT
function checkPunishment(){
  const b=document.getElementById('punishBanner');
  if(store.punishment&&store.punishment.active&&store.punishment.date===todayKey()){
    b.classList.add('show');
    document.getElementById('punishMeta').textContent=`${store.punishment.missed} habit(s) missed • -${store.punishment.penalty} EXP deducted`;
    document.getElementById('punishTask').textContent=`— ${store.punishment.task} —`;
  } else b.classList.remove('show');
}
function completePunishment(){
  store.punishment.active=false;
  applyExp(300,'Punishment Cleared! +300 EXP ⚔️');
  document.getElementById('punishBanner').classList.remove('show');
  save(store);
}

// DAILY QUEST
function renderDailyQuest(){
  const q=getDQ();
  const done=!!store.today.dailyQuestDone;
  document.getElementById('dailyQuestBox').innerHTML=`
    <div style="background:rgba(255,214,0,0.05);border:1px solid rgba(255,214,0,0.2);border-radius:14px;padding:16px;margin-bottom:14px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
        <span style="font-family:monospace;font-size:9px;letter-spacing:2px;color:var(--y);text-transform:uppercase;">⚡ Daily System Quest</span>
        <span style="font-size:18px;font-weight:900;color:var(--y);">+${q.exp} EXP</span>
      </div>
      <div style="font-size:13px;font-weight:700;color:${done?'rgba(240,240,240,0.3)':'var(--w)'};line-height:1.4;margin-bottom:12px;${done?'text-decoration:line-through;text-decoration-color:var(--g);':''}">
        ${q.task}
      </div>
      ${done
        ?'<div style="font-family:monospace;font-size:10px;color:var(--g);letter-spacing:1px;text-align:center;">✓ COMPLETED — Well done Hunter</div>'
        :`<button class="btn btn-y" onclick="completeDQ()" style="margin-top:0;">⚡ Mark as Complete</button>`
      }
    </div>
  `;
}
function completeDQ(){
  if(store.today.dailyQuestDone)return;
  store.today.dailyQuestDone=true;
  const q=getDQ();
  applyExp(q.exp,`System Quest! +${q.exp} EXP ⚡`);
  renderDailyQuest();
  autoSave();
}

// TODOS
function renderTodos(){
  const list=document.getElementById('todoList');
  const todos=store.today.todos||[];
  const done=todos.filter(t=>t.done).length;
  document.getElementById('todoCount').textContent=todos.length===0?'0 quests':`${done}/${todos.length} done`;
  if(!todos.length){list.innerHTML='<div style="font-family:monospace;font-size:11px;color:var(--m);text-align:center;padding:20px 0;">No quests yet. Add something to crush! 🔥</div>';return;}
  list.innerHTML='';
  [...todos].sort((a,b)=>a.done-b.done).forEach(t=>{
    const d=t.done;
    const row=document.createElement('div');
    row.className='todo-row'+(d?' done-t':'');
    row.innerHTML=`
      <div class="chk ${d?'hrow done':''}" style="${d?'background:var(--g);border-color:var(--g);color:#000;box-shadow:0 0 10px var(--gg);':''}" onclick="toggleTodo(${t.id})">${d?'✓':''}</div>
      <div style="flex:1;font-size:13px;font-weight:600;color:${d?'rgba(240,240,240,0.3)':'var(--w)'};text-decoration:${d?'line-through':'none'};cursor:pointer;" onclick="toggleTodo(${t.id})">${t.text}</div>
      <span style="font-family:monospace;font-size:9px;color:${d?'var(--g)':'var(--m)'};margin-right:4px;">+50</span>
      <button class="del-btn" onclick="deleteTodo(${t.id})">✕</button>
    `;
    list.appendChild(row);
  });
}
function addTodo(){
  const inp=document.getElementById('todoInput');
  const text=inp.value.trim();
  if(!text)return;
  if(!store.today.todos)store.today.todos=[];
  store.today.todos.push({id:Date.now(),text,done:false});
  inp.value='';
  save(store);renderTodos();
}
function toggleTodo(id){
  const t=store.today.todos.find(t=>t.id===id);
  if(!t)return;
  const was=t.done;t.done=!was;
  applyExp(was?-50:50,was?'Quest unticked -50 EXP':'Quest done! +50 EXP ⚡');
  renderTodos();autoSave();
}
function deleteTodo(id){store.today.todos=store.today.todos.filter(t=>t.id!==id);save(store);renderTodos();}
function clearDone(){store.today.todos=(store.today.todos||[]).filter(t=>!t.done);save(store);renderTodos();}

// RANKS PAGE
function renderRanksPage(){
  const cur=getRank(store.totalExp);
  const inRank=store.totalExp-cur.min;
  const needed=cur.max-cur.min;
  const pct=Math.min(100,(inRank/needed)*100);
  document.getElementById('ranksList').innerHTML=RANKS.map(r=>{
    const isCur=r.rank===cur.rank;
    const unlocked=store.totalExp>=r.min;
    return`<div class="rank-row${isCur?' current-rank':''}" style="background:${isCur?r.bg:'#111118'};border-color:${isCur?r.color+'50':'var(--b)'};opacity:${unlocked?1:0.4};">
      <div style="display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="font-size:32px;font-weight:900;color:${r.color};text-shadow:${isCur?`0 0 20px ${r.color}`:'none'};width:50px;">${r.rank}</div>
          <div>
            <div style="font-size:14px;font-weight:700;color:${isCur?r.color:'var(--w)'};">${r.name}</div>
            <div style="font-family:monospace;font-size:9px;color:var(--m);margin-top:2px;">${num(r.min)} — ${num(r.max)} EXP</div>
          </div>
        </div>
        ${isCur?`<div style="font-family:monospace;font-size:9px;color:${r.color};background:${r.color}15;border:1px solid ${r.color}30;border-radius:99px;padding:3px 10px;">CURRENT</div>`:unlocked?`<div style="font-family:monospace;font-size:9px;color:#39ff14;">✓</div>`:''}
      </div>
      ${isCur?`<div style="margin-top:10px;"><div class="bar-bg"><div class="bar-fill" style="width:${pct}%;background:${r.color};box-shadow:0 0 8px ${r.color}80;"></div></div><div style="font-family:monospace;font-size:9px;color:var(--m);margin-top:4px;text-align:right;">${num(inRank)} / ${num(needed)} EXP</div></div>`:''}
    </div>`;
  }).join('');
  document.getElementById('expGuide').innerHTML=EXP_GUIDE.map(([l,c,v])=>`
    <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #1a1a22;">
      <span style="font-family:monospace;font-size:10px;color:var(--m);">${l}</span>
      <span style="font-family:monospace;font-size:10px;color:${c};font-weight:700;">${v}</span>
    </div>`).join('');
}

// STRUGGLES
function renderStruggles(){
  const hist=store.history||[];
  const el=document.getElementById('struggleList');
  const statsEl=document.getElementById('overallStats');
  if(!hist.length){el.innerHTML='<div style="font-family:monospace;font-size:11px;color:var(--m);text-align:center;padding:30px 0;">Save at least 1 day to see your struggles.</div>';statsEl.innerHTML='';return;}
  const rates=HABITS.map(h=>{
    const done=hist.filter(d=>!!(d.checked||{})[h.id]).length;
    return{...h,rate:Math.round((done/hist.length)*100)};
  }).sort((a,b)=>a.rate-b.rate);
  el.innerHTML=rates.map(h=>{
    const c=h.rate>=70?'#39ff14':h.rate>=40?'#ffd600':'#ff3c3c';
    const name=h.text.replace(/^.\s/,'');
    return`<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
      <div style="font-size:12px;font-weight:700;color:var(--w);width:155px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${name}</div>
      <div class="sbar-bg"><div class="sbar-fill" style="width:${h.rate}%;background:${c};box-shadow:0 0 6px ${c}80;"></div></div>
      <div style="font-family:monospace;font-size:10px;color:var(--m);width:32px;text-align:right;">${h.rate}%</div>
    </div>`;
  }).join('');
  statsEl.innerHTML=`<div class="surface" style="margin-top:6px;">
    <div class="seclbl" style="margin-top:0;">Overall Stats</div>
    ${[["Days Saved",hist.length],["Total Penalties",store.penalties||0],["Best PMO Streak",(store.pmo?.best||0)+" days"],["Total EXP",num(store.totalExp||0)]].map(([l,v])=>`
      <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #1a1a22;">
        <span style="font-family:monospace;font-size:10px;color:var(--m);">${l}</span>
        <span style="font-family:monospace;font-size:10px;color:#39ff14;font-weight:700;">${v}</span>
      </div>`).join('')}
  </div>`;
}

// HISTORY
function renderHistory(){
  const hist=store.history||[];
  const el=document.getElementById('historyList');
  if(!hist.length){el.innerHTML='<div style="font-family:monospace;font-size:11px;color:var(--m);text-align:center;padding:30px 0;">No history yet. Complete habits and hit Save!</div>';return;}
  el.innerHTML=hist.map(day=>{
    const done=HABITS.filter(h=>!!(day.checked||{})[h.id]).length;
    const c=done===HABITS.length?'#39ff14':done>=4?'#ffd600':'#ff3c3c';
    return`<div style="background:var(--s);border:1px solid var(--b);border-radius:12px;padding:14px 16px;margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
        <span style="font-family:monospace;font-size:10px;color:#39ff14;letter-spacing:1.5px;">${day.date}</span>
        <span style="font-size:18px;font-weight:900;color:${c};">${done}/${HABITS.length}</span>
      </div>
      <div>${HABITS.map(h=>{
        const d=!!(day.checked||{})[h.id];
        const name=h.text.replace(/^.\s/,'').split(' ').slice(0,2).join(' ');
        return`<span class="pill ${d?'ok':'no'}">${name}</span>`;
      }).join('')}</div>
      ${day.note?`<div style="font-size:11px;color:var(--m);font-style:italic;margin-top:8px;border-top:1px solid var(--b);padding-top:8px;">"${day.note}"</div>`:''}
    </div>`;
  }).join('');
}

// PMO
function renderPmo(){
  const p=store.pmo||{days:0,best:0,resets:0};
  document.getElementById('pmoDays').textContent=p.days||0;
  document.getElementById('pmoDisplay').textContent=p.days||0;
  document.getElementById('pmoBest').textContent=(p.best||0)+' days';
  document.getElementById('pmoResets').textContent=p.resets||0;
}
function addPmoDay(){
  if(!store.pmo)store.pmo={days:0,best:0,resets:0};
  store.pmo.days++;
  if(store.pmo.days>store.pmo.best)store.pmo.best=store.pmo.days;
  applyExp(100,'Clean Day! +100 EXP 🔥');
  renderPmo();
}
function showPmoConfirm(){
  const cur=store.pmo?.days||0;
  document.getElementById('pmoConfirmText').textContent=cur<5?`You're at ${cur} days. Resetting will cost -500 EXP.`:`You held ${cur} days. Resetting costs only -100 EXP. Be honest.`;
  document.getElementById('pmoOverlay').classList.add('show');
}
function closePmoConfirm(){document.getElementById('pmoOverlay').classList.remove('show');}
function confirmRelapse(){
  const cur=store.pmo?.days||0;
  const penalty=cur<5?500:100;
  store.pmo.resets=(store.pmo.resets||0)+1;
  if(cur>(store.pmo.best||0))store.pmo.best=cur;
  store.pmo.days=0;
  applyExp(-penalty,cur<5?`-${penalty} EXP — Relapsed early 💀`:`-${penalty} EXP — Rise again 💪`);
  renderPmo();closePmoConfirm();save(store);
}

// TABS
function switchTab(name,btn){
  document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  if(name==='ranks')renderRanksPage();
  if(name==='struggles')renderStruggles();
  if(name==='history')renderHistory();
  if(name==='quests'){renderDailyQuest();renderTodos();}
  if(name==='pmo')renderPmo();
}

// TIMER
function updateTimer(){
  const now=new Date(),mid=new Date();mid.setHours(24,0,0,0);
  const d=mid-now,h=Math.floor(d/3600000),m=Math.floor((d%3600000)/60000),s=Math.floor((d%60000)/1000);
  document.getElementById('timerDisp').textContent=`Resets in ${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

// MIDNIGHT CHECK
function midnightCheck(){
  if(todayKey()!==store.today?.date){
    store=load();
    const newToday=todayKey();
    if(!store.today||store.today.date!==newToday){
      if(store.today){
        const missed=HABITS.filter(h=>!store.today.checked[h.id]).length;
        if(missed>0){
          const penalty=missed*100;
          store.totalExp=Math.max(0,(store.totalExp||0)-penalty);
          store.penalties=(store.penalties||0)+1;
          let pool=missed===1?P1:missed<=3?P2:missed<=5?P3:P4;
          store.punishment={active:true,task:rnd(pool),date:newToday,missed,penalty};
        } else store.totalExp=(store.totalExp||0)+200;
        if(!store.history)store.history=[];
        if(!store.history.find(h=>h.date===store.today.date))store.history.unshift({...store.today});
      }
      store.today={date:newToday,checked:{},todos:[],note:'',dailyQuestDone:false};
      save(store);
    }
    renderHabits();renderRankHero();renderDailyQuest();renderTodos();renderPmo();
    document.getElementById('noteBox').value='';
    document.getElementById('dateDisp').textContent=fmtDate();
    checkPunishment();
  }
}

// INIT
document.getElementById('dateDisp').textContent=fmtDate();
document.getElementById('noteBox').value=store.today.note||'';
renderHabits();renderRankHero();renderDailyQuest();renderTodos();renderPmo();checkPunishment();
setInterval(updateTimer,1000);
setInterval(midnightCheck,30000);
updateTimer();
</script>
</body>
</html>
